<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flowspace.database.service.impl.BlockDatabaseMapper">

    <!-- 이메일로 사용자 번호 (sp_user_id_by_email) -->
    <select id="selectUserIdByEmail" statementType="CALLABLE" resultType="long">
        {call sp_user_id_by_email(#{email})}
    </select>

    <!-- ==================== 페이지·블록 ==================== -->

    <!-- 페이지 정보 (sp_page) -->
    <select id="selectPage" statementType="CALLABLE" resultType="com.flowspace.page.service.PageVO">
        {call sp_page(#{pageId})}
    </select>

    <!-- 페이지 정보 + 행 잠금 (sp_page_lock, 휴지통 제외) -->
    <select id="selectPageForUpdate" statementType="CALLABLE" resultType="com.flowspace.page.service.PageVO">
        {call sp_page_lock(#{pageId})}
    </select>

    <!-- 페이지 버전 +1 (sp_page_version_update) -->
    <update id="updatePageVersion" statementType="CALLABLE">
        {call sp_page_version_update(#{pageId})}
    </update>

    <!-- 페이지의 블록 수 (sp_page_block_count) -->
    <select id="selectBlockCount" statementType="CALLABLE" resultType="int">
        {call sp_page_block_count(#{pageId})}
    </select>

    <!-- 데이터베이스 블록 등록 (sp_block_database_block_insert) -->
    <insert id="insertBlock" statementType="CALLABLE" parameterType="com.flowspace.block.service.BlockVO">
        {call sp_block_database_block_insert(#{pageId}, #{type}, #{position}, #{createdBy},
                                             #{blockId, mode=OUT, jdbcType=BIGINT})}
    </insert>

    <!-- 행 페이지 등록 (sp_block_database_row_page_insert, 제목·순서는 DB 기본값) -->
    <insert id="insertPage" statementType="CALLABLE" parameterType="com.flowspace.page.service.PageVO">
        {call sp_block_database_row_page_insert(#{workspaceId}, #{parentPageId}, #{createdBy},
                                                #{pageId, mode=OUT, jdbcType=BIGINT})}
    </insert>

    <!-- 페이지를 쓰는 행 수 (sp_block_database_row_count_by_page) -->
    <select id="selectRowCountByPage" statementType="CALLABLE" resultType="int">
        {call sp_block_database_row_count_by_page(#{pageId})}
    </select>

    <!-- ==================== 데이터베이스 ==================== -->

    <!-- 데이터베이스 한 개 (sp_block_database) -->
    <select id="selectDatabase" statementType="CALLABLE" resultType="com.flowspace.database.service.BlockDatabaseVO">
        {call sp_block_database(#{databaseId})}
    </select>

    <!-- 데이터베이스 등록 (sp_block_database_insert) -->
    <insert id="insertDatabase" statementType="CALLABLE" parameterType="com.flowspace.database.service.BlockDatabaseVO">
        {call sp_block_database_insert(#{blockId}, #{title}, #{viewType}, #{databaseId, mode=OUT, jdbcType=BIGINT})}
    </insert>

    <!-- 제목 수정 (sp_block_database_title_update) -->
    <update id="updateDatabaseTitle" statementType="CALLABLE">
        {call sp_block_database_title_update(#{title}, #{databaseId})}
    </update>

    <!-- 표 / 데이터베이스 전환 (sp_block_database_view_type_update) -->
    <update id="updateDatabaseViewType" statementType="CALLABLE">
        {call sp_block_database_view_type_update(#{viewType}, #{databaseId})}
    </update>

    <!-- 데이터베이스 삭제 (sp_block_database_delete) -->
    <delete id="deleteDatabase" statementType="CALLABLE">
        {call sp_block_database_delete(#{databaseId})}
    </delete>

    <!-- ==================== 컬럼 ==================== -->

    <!-- 컬럼 목록 (sp_block_database_column_list) -->
    <select id="selectColumnList" statementType="CALLABLE"
            resultType="com.flowspace.database.service.BlockDatabaseColumnVO">
        {call sp_block_database_column_list(#{databaseId})}
    </select>

    <!-- 컬럼 한 개 (sp_block_database_column) -->
    <select id="selectColumn" statementType="CALLABLE"
            resultType="com.flowspace.database.service.BlockDatabaseColumnVO">
        {call sp_block_database_column(#{columnId})}
    </select>

    <!-- 여러 컬럼 (sp_block_database_column_list_by_ids) -->
    <select id="selectColumnListByIds" statementType="CALLABLE"
            resultType="com.flowspace.database.service.BlockDatabaseColumnVO">
        {call sp_block_database_column_list_by_ids(#{columnIds, typeHandler=com.flowspace.common.mybatis.IdListTypeHandler})}
    </select>

    <!-- 컬럼 수 (sp_block_database_column_count) -->
    <select id="selectColumnCount" statementType="CALLABLE" resultType="int">
        {call sp_block_database_column_count(#{databaseId})}
    </select>

    <!-- 컬럼 등록 (sp_block_database_column_insert, 너비는 DB 기본값) -->
    <insert id="insertColumn" statementType="CALLABLE" parameterType="com.flowspace.database.service.BlockDatabaseColumnVO">
        {call sp_block_database_column_insert(#{databaseId}, #{name}, #{type}, #{position},
                                              #{columnId, mode=OUT, jdbcType=BIGINT})}
    </insert>

    <!-- 이름·종류 수정 (sp_block_database_column_update) -->
    <update id="updateColumn" statementType="CALLABLE">
        {call sp_block_database_column_update(#{name}, #{type}, #{columnId})}
    </update>

    <!-- 너비 수정 (sp_block_database_column_width_update) -->
    <update id="updateColumnWidth" statementType="CALLABLE">
        {call sp_block_database_column_width_update(#{width}, #{columnId})}
    </update>

    <!-- 순서 수정 (sp_block_database_column_position_update) -->
    <update id="updateColumnPosition" statementType="CALLABLE">
        {call sp_block_database_column_position_update(#{position}, #{columnId})}
    </update>

    <!-- 컬럼 삭제 (sp_block_database_column_delete) -->
    <delete id="deleteColumn" statementType="CALLABLE">
        {call sp_block_database_column_delete(#{columnId})}
    </delete>

    <!-- ==================== 옵션 ==================== -->

    <!-- 컬럼의 옵션 목록 (sp_block_database_column_option_list) -->
    <select id="selectOptionList" statementType="CALLABLE"
            resultType="com.flowspace.database.service.BlockDatabaseColumnOptionVO">
        {call sp_block_database_column_option_list(#{columnId})}
    </select>

    <!-- 데이터베이스의 모든 옵션 (sp_block_database_option_list) -->
    <select id="selectDatabaseOptionList" statementType="CALLABLE"
            resultType="com.flowspace.database.service.BlockDatabaseColumnOptionVO">
        {call sp_block_database_option_list(#{databaseId})}
    </select>

    <!-- 옵션 한 개 (sp_block_database_option) -->
    <select id="selectOption" statementType="CALLABLE"
            resultType="com.flowspace.database.service.BlockDatabaseColumnOptionVO">
        {call sp_block_database_option(#{optionId})}
    </select>

    <!-- 여러 옵션 (sp_block_database_option_list_by_ids) -->
    <select id="selectOptionListByIds" statementType="CALLABLE"
            resultType="com.flowspace.database.service.BlockDatabaseColumnOptionVO">
        {call sp_block_database_option_list_by_ids(#{optionIds, typeHandler=com.flowspace.common.mybatis.IdListTypeHandler})}
    </select>

    <!-- 컬럼의 옵션 수 (sp_block_database_option_count) -->
    <select id="selectOptionCount" statementType="CALLABLE" resultType="int">
        {call sp_block_database_option_count(#{columnId})}
    </select>

    <!-- 옵션 등록 (sp_block_database_option_insert) -->
    <insert id="insertOption" statementType="CALLABLE" parameterType="com.flowspace.database.service.BlockDatabaseColumnOptionVO">
        {call sp_block_database_option_insert(#{columnId}, #{value}, #{color}, #{statusGroup}, #{position},
                                              #{optionId, mode=OUT, jdbcType=BIGINT})}
    </insert>

    <!-- 값·색상·상태 그룹 수정 (sp_block_database_option_update) -->
    <update id="updateOption" statementType="CALLABLE">
        {call sp_block_database_option_update(#{value}, #{color}, #{statusGroup}, #{optionId})}
    </update>

    <!-- 순서 수정 (sp_block_database_option_position_update) -->
    <update id="updateOptionPosition" statementType="CALLABLE">
        {call sp_block_database_option_position_update(#{position}, #{optionId})}
    </update>

    <!-- 옵션 삭제 (sp_block_database_option_delete) -->
    <delete id="deleteOption" statementType="CALLABLE">
        {call sp_block_database_option_delete(#{optionId})}
    </delete>

    <!-- ==================== 행 ==================== -->

    <!-- 행 목록 (sp_block_database_row_list) -->
    <select id="selectRowList" statementType="CALLABLE" resultType="com.flowspace.database.service.BlockDatabaseRowVO">
        {call sp_block_database_row_list(#{databaseId})}
    </select>

    <!-- 행 한 개 (sp_block_database_row) -->
    <select id="selectRow" statementType="CALLABLE" resultType="com.flowspace.database.service.BlockDatabaseRowVO">
        {call sp_block_database_row(#{rowId})}
    </select>

    <!-- 여러 행 (sp_block_database_row_list_by_ids) -->
    <select id="selectRowListByIds" statementType="CALLABLE"
            resultType="com.flowspace.database.service.BlockDatabaseRowVO">
        {call sp_block_database_row_list_by_ids(#{rowIds, typeHandler=com.flowspace.common.mybatis.IdListTypeHandler})}
    </select>

    <!-- 행 수 (sp_block_database_row_count) -->
    <select id="selectRowCount" statementType="CALLABLE" resultType="int">
        {call sp_block_database_row_count(#{databaseId})}
    </select>

    <!-- 행 등록 (sp_block_database_row_insert) -->
    <insert id="insertRow" statementType="CALLABLE" parameterType="com.flowspace.database.service.BlockDatabaseRowVO">
        {call sp_block_database_row_insert(#{databaseId}, #{pageId}, #{position},
                                           #{rowId, mode=OUT, jdbcType=BIGINT})}
    </insert>

    <!-- 순서 수정 (sp_block_database_row_position_update) -->
    <update id="updateRowPosition" statementType="CALLABLE">
        {call sp_block_database_row_position_update(#{position}, #{rowId})}
    </update>

    <!-- 행 삭제 (sp_block_database_row_delete) -->
    <delete id="deleteRow" statementType="CALLABLE">
        {call sp_block_database_row_delete(#{rowId})}
    </delete>

    <!-- ==================== 셀 ==================== -->

    <!-- 새 컬럼의 빈 셀 (sp_block_database_column_cell_insert, 기존 행마다) -->
    <insert id="insertColumnCells" statementType="CALLABLE">
        {call sp_block_database_column_cell_insert(#{columnId}, #{databaseId})}
    </insert>

    <!-- 새 행의 빈 셀 (sp_block_database_row_cell_insert, 컬럼마다) -->
    <insert id="insertRowCells" statementType="CALLABLE">
        {call sp_block_database_row_cell_insert(#{rowId}, #{databaseId})}
    </insert>

    <!-- 셀 한 개 (sp_block_database_cell) -->
    <select id="selectCell" statementType="CALLABLE" resultType="com.flowspace.database.service.BlockDatabaseCellVO">
        {call sp_block_database_cell(#{rowId}, #{columnId})}
    </select>

    <!-- 값 수정 (sp_block_database_cell_value_update) -->
    <update id="updateCellValue" statementType="CALLABLE">
        {call sp_block_database_cell_value_update(#{value}, #{rowId}, #{columnId})}
    </update>

    <!-- 데이터베이스의 모든 셀 (sp_block_database_cell_list) -->
    <select id="selectDatabaseCellList" statementType="CALLABLE" resultType="com.flowspace.database.service.BlockDatabaseCellVO">
        {call sp_block_database_cell_list(#{databaseId})}
    </select>

</mapper>
