<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flowspace.retrospective.service.impl.RetrospectiveMapper">

    <!-- ==================== 회고 ==================== -->

    <!-- 스프린트와 회고. 조인은 프로시저 안에서 해요(backend/database/procedures/retrospective). -->
    <select id="selectRetrospectiveList" statementType="CALLABLE" resultType="com.flowspace.retrospective.service.RetrospectiveVO">
        {call sp_retrospective_list(#{workspaceId})}
    </select>

    <!-- 회고 한 건 -->
    <select id="selectRetrospectiveById" statementType="CALLABLE" resultType="com.flowspace.retrospective.service.RetrospectiveVO">
        {call sp_retrospective(#{retrospectiveId})}
    </select>

    <!-- 스프린트의 회고 번호 -->
    <select id="selectRetrospectiveIdBySprint" resultType="long">
        SELECT retrospective_id
        FROM retrospectives
        WHERE sprint_id = #{sprintId}
    </select>

    <!-- 스프린트가 있는지 -->
    <select id="selectSprintCount" resultType="int">
        SELECT COUNT(*)
        FROM sprints
        WHERE sprint_id = #{sprintId}
    </select>

    <!-- 회고 만들기. mode=OUT 인자는 프로시저가 값을 채워서 돌려줘요 → 실행 후 retrospective.pageId에 들어가요.
         결과를 읽는 게 아니라 데이터를 만드는 일이라 select가 아니라 insert로 적어요. -->
    <insert id="insertRetrospective" statementType="CALLABLE" parameterType="com.flowspace.retrospective.service.RetrospectiveVO">
        {call sp_create_retrospective(#{sprintId}, #{workspaceId}, #{createdBy}, #{pageTitle}, #{pageIcon},
                                      #{tableTitle}, #{pageId, mode=OUT, jdbcType=BIGINT})}
    </insert>

    <!-- ==================== 스냅샷 ==================== -->

    <!-- 상태 스냅샷 -->
    <select id="selectStatusSnapshotList" resultType="com.flowspace.retrospective.service.StatusSnapshotVO">
        SELECT snapshot_status_id,
               retrospective_id,
               name,
               color,
               position
        FROM retrospective_status_snapshots
        WHERE retrospective_id = #{retrospectiveId}
        ORDER BY position, snapshot_status_id
    </select>

    <!-- 작업 스냅샷. retrospectiveId가 null일 수 있어서 jdbcType을 적어요. -->
    <select id="selectTaskSnapshotList" statementType="CALLABLE" resultType="com.flowspace.retrospective.service.TaskSnapshotVO">
        {call sp_task_snapshot_list(#{workspaceId}, #{retrospectiveId, jdbcType=BIGINT})}
    </select>

    <!-- 작업 스냅샷 담당자 -->
    <select id="selectTaskSnapshotAssigneeList" statementType="CALLABLE" resultType="com.flowspace.retrospective.service.TaskSnapshotAssigneeVO">
        {call sp_task_snapshot_assignee_list(#{workspaceId}, #{retrospectiveId, jdbcType=BIGINT})}
    </select>

    <!-- 하위 작업 스냅샷 -->
    <select id="selectSubTaskSnapshotList" statementType="CALLABLE" resultType="com.flowspace.retrospective.service.SubTaskSnapshotVO">
        {call sp_subtask_snapshot_list(#{retrospectiveId})}
    </select>

    <!-- ==================== Action Item ==================== -->

    <!-- 회고 페이지들의 TODO 블록 -->
    <select id="selectTodoBlockList" resultType="com.flowspace.retrospective.service.TodoBlockVO">
        SELECT page_id,
               content
        FROM blocks
        WHERE type = 'TODO'
          AND page_id IN
        <foreach collection="pageIds" item="pageId" open="(" separator="," close=")">
            #{pageId}
        </foreach>
    </select>

</mapper>
