<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flowspace.page.service.impl.PageMapper">

    <!-- 이메일로 사용자 번호 -->
    <select id="selectUserIdByEmail" resultType="long">
        SELECT user_id
        FROM users
        WHERE email = #{email}
    </select>

    <!-- ==================== 조회 ==================== -->

    <!-- 페이지 목록 (sp_page_list) -->
    <select id="selectPageList" statementType="CALLABLE" resultType="com.flowspace.page.service.PageVO">
        {call sp_page_list(#{workspaceId}, #{deleted})}
    </select>

    <!-- 페이지 한 개 -->
    <select id="selectPageById" statementType="CALLABLE" resultType="com.flowspace.page.service.PageVO">
        {call sp_page(#{pageId})}
    </select>

    <!-- 본인과 모든 하위 페이지 -->
    <select id="selectPageSubtree" statementType="CALLABLE" resultType="com.flowspace.page.service.PageVO">
        {call sp_page_subtree(#{pageId})}
    </select>

    <!-- 여러 페이지 (순서 바꾸기 확인용) -->
    <select id="selectPageListByIds" resultType="com.flowspace.page.service.PageVO">
        SELECT page_id,
               workspace_id,
               parent_page_id,
               is_deleted
        FROM pages
        WHERE page_id IN
        <foreach collection="pageIds" item="pageId" open="(" separator="," close=")">
            #{pageId}
        </foreach>
    </select>

    <!-- 상위 페이지 번호 -->
    <select id="selectParentPageId" resultType="long">
        SELECT parent_page_id
        FROM pages
        WHERE page_id = #{pageId}
    </select>

    <!-- 같은 상위 페이지 아래의 페이지 수 (<=>: NULL끼리 같음, XML에서는 CDATA 처리) -->
    <select id="selectSiblingCount" resultType="int">
        SELECT COUNT(*)
        FROM pages
        WHERE workspace_id = #{workspaceId}
          AND parent_page_id <![CDATA[ <=> ]]> #{parentPageId}
          AND is_deleted = FALSE
    </select>

    <!-- ==================== 등록·수정 ==================== -->

    <!-- 페이지 등록 (휴지통 여부·버전·생성 시각은 DB 기본값) -->
    <insert id="insertPage" parameterType="com.flowspace.page.service.PageVO"
            useGeneratedKeys="true" keyProperty="pageId">
        INSERT INTO pages (workspace_id, parent_page_id, title, icon, position, created_by)
        VALUES (#{workspaceId}, #{parentPageId}, #{title}, #{icon}, #{position}, #{createdBy})
    </insert>

    <!-- 제목·아이콘·상위 페이지 수정 (상위 페이지 null이면 최상위) -->
    <update id="updatePage" parameterType="com.flowspace.page.service.PageVO">
        UPDATE pages
        SET title          = #{title},
            icon           = #{icon},
            parent_page_id = #{parentPageId}
        WHERE page_id = #{pageId}
    </update>

    <!-- 순서 수정 -->
    <update id="updatePagePosition">
        UPDATE pages
        SET position = #{position}
        WHERE page_id = #{pageId}
    </update>

    <!-- 상위 페이지와 순서 수정 -->
    <update id="updatePageParent">
        UPDATE pages
        SET parent_page_id = #{parentPageId},
            position       = #{position}
        WHERE page_id = #{pageId}
    </update>

    <!-- 커버 수정 -->
    <update id="updatePageCover">
        UPDATE pages
        SET cover_file_id = #{fileId}
        WHERE page_id = #{pageId}
    </update>

    <!-- ==================== 휴지통 ==================== -->

    <!-- 여러 페이지 휴지통 이동 (같은 삭제 시각 = 함께 복원되는 묶음) -->
    <update id="updatePagesTrashed">
        UPDATE pages
        SET is_deleted = TRUE,
            deleted_at = #{deletedAt}
        WHERE page_id IN
        <foreach collection="pageIds" item="pageId" open="(" separator="," close=")">
            #{pageId}
        </foreach>
    </update>

    <!-- 여러 페이지 복원 -->
    <update id="updatePagesRestored">
        UPDATE pages
        SET is_deleted = FALSE,
            deleted_at = NULL
        WHERE page_id IN
        <foreach collection="pageIds" item="pageId" open="(" separator="," close=")">
            #{pageId}
        </foreach>
    </update>

    <!-- 휴지통으로 가는 페이지를 가리키는 데이터베이스 행 삭제 (함께 이동하는 페이지 안의 데이터베이스는 제외, 셀은 연쇄 삭제) -->
    <delete id="deleteOutsideDatabaseRows">
        DELETE r
          FROM block_database_rows r
          JOIN block_databases d ON d.database_id = r.database_id
          JOIN blocks b          ON b.block_id = d.block_id
         WHERE r.page_id IN
        <foreach collection="pageIds" item="pageId" open="(" separator="," close=")">
            #{pageId}
        </foreach>
           AND b.page_id NOT IN
        <foreach collection="subtreeIds" item="subtreeId" open="(" separator="," close=")">
            #{subtreeId}
        </foreach>
    </delete>

</mapper>
