<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flowspace.page.service.impl.PageMapper">

    <!-- 이메일로 사용자 번호 (sp_user_id_by_email) -->
    <select id="selectUserIdByEmail" statementType="CALLABLE" resultType="long">
        {call sp_user_id_by_email(#{email})}
    </select>

    <!-- ==================== 조회 ==================== -->

    <!-- 페이지 목록 (sp_page_list) -->
    <select id="selectPageList" statementType="CALLABLE" resultType="com.flowspace.page.service.PageVO">
        {call sp_page_list(#{workspaceId}, #{deleted})}
    </select>

    <!-- 페이지 한 개 -->
    <select id="selectPageById" statementType="CALLABLE" resultType="com.flowspace.page.service.PageVO">
        {call sp_page(#{pageId})}
    </select>

    <!-- 본인과 모든 하위 페이지 -->
    <select id="selectPageSubtree" statementType="CALLABLE" resultType="com.flowspace.page.service.PageVO">
        {call sp_page_subtree(#{pageId})}
    </select>

    <!-- 여러 페이지 (sp_page_list_by_ids, 순서 바꾸기 확인용) -->
    <select id="selectPageListByIds" statementType="CALLABLE" resultType="com.flowspace.page.service.PageVO">
        {call sp_page_list_by_ids(#{pageIds, typeHandler=com.flowspace.common.mybatis.IdListTypeHandler})}
    </select>

    <!-- 상위 페이지 번호 (sp_page_parent_id) -->
    <select id="selectParentPageId" statementType="CALLABLE" resultType="long">
        {call sp_page_parent_id(#{pageId})}
    </select>

    <!-- 같은 상위 페이지 아래의 페이지 수 (sp_page_sibling_count, <=>: NULL끼리 같음) -->
    <select id="selectSiblingCount" statementType="CALLABLE" resultType="int">
        {call sp_page_sibling_count(#{workspaceId}, #{parentPageId})}
    </select>

    <!-- ==================== 등록·수정 ==================== -->

    <!-- 페이지 등록 (sp_page_insert, 휴지통 여부·버전·생성 시각은 DB 기본값) -->
    <insert id="insertPage" statementType="CALLABLE" parameterType="com.flowspace.page.service.PageVO">
        {call sp_page_insert(#{workspaceId}, #{parentPageId}, #{title}, #{icon}, #{coverFileId}, #{position},
                             #{createdBy}, #{pageId, mode=OUT, jdbcType=BIGINT})}
    </insert>

    <!-- 제목·아이콘·상위 페이지 수정 (sp_page_update, 상위 페이지 null이면 최상위) -->
    <update id="updatePage" statementType="CALLABLE" parameterType="com.flowspace.page.service.PageVO">
        {call sp_page_update(#{title}, #{icon}, #{parentPageId}, #{pageId})}
    </update>

    <!-- 순서 수정 (sp_page_position_update) -->
    <update id="updatePagePosition" statementType="CALLABLE">
        {call sp_page_position_update(#{position}, #{pageId})}
    </update>

    <!-- 상위 페이지와 순서 수정 (sp_page_parent_update) -->
    <update id="updatePageParent" statementType="CALLABLE">
        {call sp_page_parent_update(#{parentPageId}, #{position}, #{pageId})}
    </update>

    <!-- 커버 수정 (sp_page_cover_update) -->
    <update id="updatePageCover" statementType="CALLABLE">
        {call sp_page_cover_update(#{fileId}, #{pageId})}
    </update>

    <!-- ==================== 휴지통 ==================== -->

    <!-- 여러 페이지 휴지통 이동 (sp_page_trash_update, 같은 삭제 시각 = 함께 복원되는 묶음) -->
    <update id="updatePagesTrashed" statementType="CALLABLE">
        {call sp_page_trash_update(#{deletedAt},
                                   #{pageIds, typeHandler=com.flowspace.common.mybatis.IdListTypeHandler})}
    </update>

    <!-- 여러 페이지 복원 (sp_page_restore_update) -->
    <update id="updatePagesRestored" statementType="CALLABLE">
        {call sp_page_restore_update(#{pageIds, typeHandler=com.flowspace.common.mybatis.IdListTypeHandler})}
    </update>

    <!-- 휴지통으로 가는 페이지를 가리키는 데이터베이스 행 삭제 (sp_page_outside_database_row_delete, 함께 이동하는 페이지 안의 데이터베이스는 제외, 셀은 연쇄 삭제) -->
    <delete id="deleteOutsideDatabaseRows" statementType="CALLABLE">
        {call sp_page_outside_database_row_delete(#{pageIds, typeHandler=com.flowspace.common.mybatis.IdListTypeHandler},
                                                  #{subtreeIds, typeHandler=com.flowspace.common.mybatis.IdListTypeHandler})}
    </delete>

    <!-- ==================== 상세 조회 ==================== -->

    <!-- 휴지통이 아닌 하위 페이지 (sp_page_child_list) -->
    <select id="selectChildPageList" statementType="CALLABLE" resultType="com.flowspace.page.service.PageVO">
        {call sp_page_child_list(#{pageId})}
    </select>

    <!-- ==================== 영구 삭제 ==================== -->

    <!-- 보관 기간이 지난 휴지통 페이지 (sp_page_expired_trash_list, 모든 워크스페이스) -->
    <select id="selectExpiredTrashList" statementType="CALLABLE" resultType="com.flowspace.page.service.PageVO">
        {call sp_page_expired_trash_list(#{cutoff})}
    </select>

    <!-- 주어진 페이지 중 회고 페이지 번호 (sp_page_retrospective_id_list) -->
    <select id="selectRetrospectivePageIds" statementType="CALLABLE" resultType="long">
        {call sp_page_retrospective_id_list(#{pageIds, typeHandler=com.flowspace.common.mybatis.IdListTypeHandler})}
    </select>

    <!-- 페이지 커버·블록 이미지 파일 번호 (sp_page_file_id_list, UNION으로 중복 제외) -->
    <select id="selectPageFileIds" statementType="CALLABLE" resultType="long">
        {call sp_page_file_id_list(#{pageIds, typeHandler=com.flowspace.common.mybatis.IdListTypeHandler})}
    </select>

    <!-- 페이지를 가리키는 데이터베이스 행 삭제 (sp_page_database_row_delete) -->
    <delete id="deleteDatabaseRowsByPages" statementType="CALLABLE">
        {call sp_page_database_row_delete(#{pageIds, typeHandler=com.flowspace.common.mybatis.IdListTypeHandler})}
    </delete>

    <!-- 페이지 삭제 (sp_page_delete, 블록·데이터베이스는 CASCADE) -->
    <delete id="deletePage" statementType="CALLABLE">
        {call sp_page_delete(#{pageId})}
    </delete>

</mapper>
