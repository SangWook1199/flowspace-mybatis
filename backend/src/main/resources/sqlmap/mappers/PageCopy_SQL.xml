<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flowspace.page.service.impl.PageCopyMapper">

    <!-- ==================== 블록 ==================== -->

    <!-- 페이지의 블록 목록 (sp_copy_block_list) -->
    <select id="selectBlockList" statementType="CALLABLE" resultType="com.flowspace.block.service.BlockVO">
        {call sp_copy_block_list(#{pageId})}
    </select>

    <!-- 블록 복사본 등록 (sp_copy_block_insert, 상위 블록은 나중에 연결) -->
    <insert id="insertBlock" statementType="CALLABLE" parameterType="com.flowspace.block.service.BlockVO">
        {call sp_copy_block_insert(#{pageId}, #{taskId}, #{eventId}, #{sprintId}, #{imageFileId}, #{type},
                                   #{position}, #{content}, #{createdBy}, #{blockId, mode=OUT, jdbcType=BIGINT})}
    </insert>

    <!-- 상위 블록 연결 (sp_copy_block_parent_update) -->
    <update id="updateBlockParent" statementType="CALLABLE">
        {call sp_copy_block_parent_update(#{parentBlockId}, #{blockId})}
    </update>

    <!-- ==================== 데이터베이스 ==================== -->

    <!-- 블록의 데이터베이스 (sp_copy_database) -->
    <select id="selectDatabaseByBlock" statementType="CALLABLE"
            resultType="com.flowspace.database.service.BlockDatabaseVO">
        {call sp_copy_database(#{blockId})}
    </select>

    <!-- 데이터베이스 복사본 등록 (sp_copy_database_insert) -->
    <insert id="insertDatabase" statementType="CALLABLE" parameterType="com.flowspace.database.service.BlockDatabaseVO">
        {call sp_copy_database_insert(#{blockId}, #{title}, #{viewType}, #{databaseId, mode=OUT, jdbcType=BIGINT})}
    </insert>

    <!-- 컬럼 목록 (sp_copy_column_list) -->
    <select id="selectColumnList" statementType="CALLABLE"
            resultType="com.flowspace.database.service.BlockDatabaseColumnVO">
        {call sp_copy_column_list(#{databaseId})}
    </select>

    <!-- 컬럼 복사본 등록 (sp_copy_column_insert) -->
    <insert id="insertColumn" statementType="CALLABLE" parameterType="com.flowspace.database.service.BlockDatabaseColumnVO">
        {call sp_copy_column_insert(#{databaseId}, #{name}, #{type}, #{position}, #{width},
                                    #{columnId, mode=OUT, jdbcType=BIGINT})}
    </insert>

    <!-- 옵션 복사 (sp_copy_option_insert, 원본 컬럼 → 새 컬럼) -->
    <insert id="insertOptionCopies" statementType="CALLABLE">
        {call sp_copy_option_insert(#{columnId}, #{sourceColumnId})}
    </insert>

    <!-- 행 목록 (sp_copy_row_list) -->
    <select id="selectRowList" statementType="CALLABLE" resultType="com.flowspace.database.service.BlockDatabaseRowVO">
        {call sp_copy_row_list(#{databaseId})}
    </select>

    <!-- 행 복사본 등록 (sp_copy_row_insert) -->
    <insert id="insertRow" statementType="CALLABLE" parameterType="com.flowspace.database.service.BlockDatabaseRowVO">
        {call sp_copy_row_insert(#{databaseId}, #{pageId}, #{position}, #{rowId, mode=OUT, jdbcType=BIGINT})}
    </insert>

    <!-- 셀 복사 (sp_copy_cell_insert, 원본 행 → 새 행, 컬럼 번호는 원본 → 새 번호 쌍으로 교체) -->
    <insert id="insertCellCopies" statementType="CALLABLE">
        {call sp_copy_cell_insert(#{sourceRowId}, #{rowId},
                                  #{columnIdMap, typeHandler=com.flowspace.common.mybatis.IdMapTypeHandler})}
    </insert>

</mapper>
