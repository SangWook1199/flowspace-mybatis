<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flowspace.block.service.impl.BlockMapper">

    <!-- 이메일로 사용자 번호 (sp_user_id_by_email) -->
    <select id="selectUserIdByEmail" statementType="CALLABLE" resultType="long">
        {call sp_user_id_by_email(#{email})}
    </select>

    <!-- ==================== 블록이 있는 페이지 ==================== -->

    <!-- 페이지 정보 (sp_page) -->
    <select id="selectBlockPage" statementType="CALLABLE" resultType="com.flowspace.page.service.PageVO">
        {call sp_page(#{pageId})}
    </select>

    <!-- 페이지 정보 + 트랜잭션 끝까지 행 잠금 (sp_page_lock, FOR UPDATE, 휴지통 제외) -->
    <select id="selectBlockPageForUpdate" statementType="CALLABLE" resultType="com.flowspace.page.service.PageVO">
        {call sp_page_lock(#{pageId})}
    </select>

    <!-- 페이지 버전 +1 (sp_page_version_update) -->
    <update id="updatePageVersion" statementType="CALLABLE">
        {call sp_page_version_update(#{pageId})}
    </update>

    <!-- ==================== 블록 조회 ==================== -->

    <!-- 블록 목록 (sp_block_list) -->
    <select id="selectBlockList" statementType="CALLABLE" resultType="com.flowspace.block.service.BlockVO">
        {call sp_block_list(#{pageId})}
    </select>

    <!-- 블록 한 개 -->
    <select id="selectBlockById" statementType="CALLABLE" resultType="com.flowspace.block.service.BlockVO">
        {call sp_block(#{blockId})}
    </select>

    <!-- 페이지의 블록 수 (sp_page_block_count) -->
    <select id="selectBlockCount" statementType="CALLABLE" resultType="int">
        {call sp_page_block_count(#{pageId})}
    </select>

    <!-- 여러 블록의 페이지 번호 (sp_block_list_by_ids) -->
    <select id="selectBlockListByIds" statementType="CALLABLE" resultType="com.flowspace.block.service.BlockVO">
        {call sp_block_list_by_ids(#{blockIds, typeHandler=com.flowspace.common.mybatis.IdListTypeHandler})}
    </select>

    <!-- 상위 블록 번호 (sp_block_parent_id) -->
    <select id="selectParentBlockId" statementType="CALLABLE" resultType="long">
        {call sp_block_parent_id(#{blockId})}
    </select>

    <!-- ==================== 업무 블록이 가리키는 대상 ==================== -->

    <!-- 작업의 워크스페이스 (sp_task_workspace_id) -->
    <select id="selectTaskWorkspaceId" statementType="CALLABLE" resultType="long">
        {call sp_task_workspace_id(#{taskId})}
    </select>

    <!-- 일정의 워크스페이스 (sp_event_workspace_id) -->
    <select id="selectEventWorkspaceId" statementType="CALLABLE" resultType="long">
        {call sp_event_workspace_id(#{eventId})}
    </select>

    <!-- 스프린트가 속한 워크스페이스 (sp_sprint_workspace_id) -->
    <select id="selectSprintWorkspaceId" statementType="CALLABLE" resultType="long">
        {call sp_sprint_workspace_id(#{sprintId})}
    </select>

    <!-- ==================== 등록·수정·삭제 ==================== -->

    <!-- 블록 등록 (sp_block_insert, content는 JSON 컬럼) -->
    <insert id="insertBlock" statementType="CALLABLE" parameterType="com.flowspace.block.service.BlockVO">
        {call sp_block_insert(#{pageId}, #{parentBlockId}, #{taskId}, #{eventId}, #{sprintId}, #{type}, #{position},
                              #{content}, #{createdBy}, #{blockId, mode=OUT, jdbcType=BIGINT})}
    </insert>

    <!-- 종류·내용 수정 (sp_block_content_update) -->
    <update id="updateBlockContent" statementType="CALLABLE">
        {call sp_block_content_update(#{type}, #{content}, #{updatedBy}, #{blockId})}
    </update>

    <!-- 일괄 저장: 종류·내용·연결·상위 블록·순서 (sp_block_sync_update) -->
    <update id="updateBlockSync" statementType="CALLABLE" parameterType="com.flowspace.block.service.BlockVO">
        {call sp_block_sync_update(#{type}, #{content}, #{taskId}, #{eventId}, #{sprintId}, #{parentBlockId},
                                   #{position}, #{updatedBy}, #{blockId})}
    </update>

    <!-- 상위 블록과 순서 (sp_block_parent_update) -->
    <update id="updateBlockParent" statementType="CALLABLE">
        {call sp_block_parent_update(#{parentBlockId}, #{position}, #{blockId})}
    </update>

    <!-- 순서 (sp_block_position_update) -->
    <update id="updateBlockPosition" statementType="CALLABLE">
        {call sp_block_position_update(#{position}, #{blockId})}
    </update>

    <!-- 이미지 (sp_block_image_update) -->
    <update id="updateBlockImage" statementType="CALLABLE">
        {call sp_block_image_update(#{fileId}, #{blockId})}
    </update>

    <!-- 여러 블록의 상위 블록 연결 끊기 (sp_block_parent_clear) -->
    <update id="updateBlockParentsCleared" statementType="CALLABLE">
        {call sp_block_parent_clear(#{blockIds, typeHandler=com.flowspace.common.mybatis.IdListTypeHandler})}
    </update>

    <!-- 블록 삭제 (sp_block_delete, 하위 블록·댓글·데이터베이스는 ON DELETE CASCADE) -->
    <delete id="deleteBlock" statementType="CALLABLE">
        {call sp_block_delete(#{blockId})}
    </delete>

    <!-- 여러 블록 삭제 (sp_block_list_delete) -->
    <delete id="deleteBlocks" statementType="CALLABLE">
        {call sp_block_list_delete(#{blockIds, typeHandler=com.flowspace.common.mybatis.IdListTypeHandler})}
    </delete>

</mapper>
