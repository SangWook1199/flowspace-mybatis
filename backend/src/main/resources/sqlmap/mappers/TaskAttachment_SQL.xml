<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flowspace.task.service.impl.TaskAttachmentMapper">

    <!-- 이메일로 사용자 번호 (sp_user_id_by_email) -->
    <select id="selectUserIdByEmail" statementType="CALLABLE" resultType="long">
        {call sp_user_id_by_email(#{email})}
    </select>

    <!-- 관련 문서 목록 (sp_task_attachment_list) -->
    <select id="selectTaskAttachmentList" statementType="CALLABLE" resultType="com.flowspace.task.service.TaskAttachmentVO">
        {call sp_task_attachment_list(#{taskId})}
    </select>

    <!-- 관련 문서 한 건 -->
    <select id="selectTaskAttachmentById" statementType="CALLABLE" resultType="com.flowspace.task.service.TaskAttachmentVO">
        {call sp_task_attachment(#{attachmentId})}
    </select>

    <!-- 작업의 관련 문서 수 (sp_task_attachment_count) -->
    <select id="selectTaskAttachmentCount" statementType="CALLABLE" resultType="int">
        {call sp_task_attachment_count(#{taskId})}
    </select>

    <!-- 페이지 연결 여부 (sp_task_attachment_page_count) -->
    <select id="selectTaskAttachmentPageCount" statementType="CALLABLE" resultType="int">
        {call sp_task_attachment_page_count(#{taskId}, #{pageId})}
    </select>

    <!-- 작업에 업로드한 파일 번호 (sp_task_attachment_file_id_list) -->
    <select id="selectTaskAttachmentFileIds" statementType="CALLABLE" resultType="long">
        {call sp_task_attachment_file_id_list(#{taskId})}
    </select>

    <!-- 연결할 페이지의 워크스페이스 (sp_active_page_workspace_id, 휴지통 페이지 제외) -->
    <select id="selectActivePageWorkspaceId" statementType="CALLABLE" resultType="long">
        {call sp_active_page_workspace_id(#{pageId})}
    </select>

    <!-- 관련 문서 등록 (sp_task_attachment_insert, pageId, fileId 중 하나) -->
    <insert id="insertTaskAttachment" statementType="CALLABLE" parameterType="com.flowspace.task.service.TaskAttachmentVO">
        {call sp_task_attachment_insert(#{taskId}, #{pageId}, #{fileId}, #{createdBy},
                                        #{attachmentId, mode=OUT, jdbcType=BIGINT})}
    </insert>

    <!-- 관련 문서 삭제 (sp_task_attachment_delete) -->
    <delete id="deleteTaskAttachment" statementType="CALLABLE">
        {call sp_task_attachment_delete(#{attachmentId})}
    </delete>

</mapper>
