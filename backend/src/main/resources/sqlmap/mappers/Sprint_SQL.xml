<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flowspace.sprint.service.impl.SprintMapper">

    <!-- 스프린트 조회에 공통으로 쓰는 컬럼 목록 -->
    <sql id="sprintColumns">
        sprint_id, workspace_id, created_by, name, goal, description,
        color, start_date, end_date, status, created_at
    </sql>

    <!-- 스프린트 한 건 -->
    <select id="selectSprintById" resultType="com.flowspace.sprint.service.SprintVO">
        SELECT <include refid="sprintColumns"/>
        FROM sprints
        WHERE sprint_id = #{sprintId}
    </select>

    <!-- 워크스페이스의 스프린트 목록과 진행 상황. 조인과 집계는 프로시저 안에서 해요(backend/database/procedures). -->
    <select id="selectSprintProgressList" statementType="CALLABLE"
            resultType="com.flowspace.sprint.service.SprintProgressVO">
        {call sp_sprint_progress_list(#{workspaceId})}
    </select>

    <!-- 스프린트 한 건과 진행 상황 -->
    <select id="selectSprintProgressById" statementType="CALLABLE"
            resultType="com.flowspace.sprint.service.SprintProgressVO">
        {call sp_sprint_progress(#{sprintId})}
    </select>

</mapper>
