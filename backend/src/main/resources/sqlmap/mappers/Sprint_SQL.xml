<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flowspace.sprint.service.impl.SprintMapper">

    <!-- 스프린트 조회에 공통으로 쓰는 컬럼 목록 -->
    <sql id="sprintColumns">
        sprint_id, workspace_id, created_by, name, goal, description,
        color, start_date, end_date, status, created_at
    </sql>

    <!-- 스프린트 한 건 -->
    <select id="selectSprintById" resultType="com.flowspace.sprint.service.SprintVO">
        SELECT <include refid="sprintColumns"/>
        FROM sprints
        WHERE sprint_id = #{sprintId}
    </select>

    <!-- 워크스페이스의 스프린트 목록과 진행 상황. 조인과 집계는 프로시저 안에서 해요(backend/database/procedures/sprint). -->
    <select id="selectSprintProgressList" statementType="CALLABLE"
            resultType="com.flowspace.sprint.service.SprintProgressVO">
        {call sp_sprint_progress_list(#{workspaceId})}
    </select>

    <!-- 스프린트 한 건과 진행 상황 -->
    <select id="selectSprintProgressById" statementType="CALLABLE"
            resultType="com.flowspace.sprint.service.SprintProgressVO">
        {call sp_sprint_progress(#{sprintId})}
    </select>

    <!-- 워크스페이스에서 해당 상태인 스프린트 수 -->
    <select id="selectSprintCountByStatus" resultType="int">
        SELECT COUNT(*)
        FROM sprints
        WHERE workspace_id = #{workspaceId}
          AND status = #{status}
    </select>

    <!-- 스프린트 등록
         useGeneratedKeys, keyProperty: DB가 만든 sprint_id를 VO의 sprintId에 넣어 줘요.
         created_at은 넣지 않아서 DB 기본값(CURRENT_TIMESTAMP)이 들어가요. -->
    <insert id="insertSprint" parameterType="com.flowspace.sprint.service.SprintVO"
            useGeneratedKeys="true" keyProperty="sprintId">
        INSERT INTO sprints (workspace_id, created_by, name, goal, description,
                             color, start_date, end_date, status)
        VALUES (#{workspaceId}, #{createdBy}, #{name}, #{goal}, #{description},
                #{color}, #{startDate}, #{endDate}, #{status})
    </insert>

    <!-- 스프린트 수정 (상태는 상태 변경에서만 바꿔요) -->
    <update id="updateSprint" parameterType="com.flowspace.sprint.service.SprintVO">
        UPDATE sprints
           SET name        = #{name},
               goal        = #{goal},
               description = #{description},
               color       = #{color},
               start_date  = #{startDate},
               end_date    = #{endDate}
         WHERE sprint_id = #{sprintId}
    </update>

    <!-- 스프린트 시작. 진행 중이던 다른 스프린트를 계획됨으로 돌리는 것까지 프로시저 안에서 해요. -->
    <update id="updateSprintStart" statementType="CALLABLE">
        {call sp_start_sprint(#{sprintId})}
    </update>

    <!-- 스프린트 완료. 끝나지 않은 작업을 백로그로 옮기는 것까지 프로시저 안에서 해요. -->
    <update id="updateSprintComplete" statementType="CALLABLE">
        {call sp_complete_sprint(#{sprintId})}
    </update>

    <!-- 스프린트 삭제. 작업을 백로그로 옮기고 스프린트를 지우는 일을 프로시저 안에서 한 번에 해요. -->
    <delete id="deleteSprint" statementType="CALLABLE">
        {call sp_delete_sprint(#{sprintId})}
    </delete>

</mapper>
