<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flowspace.sprint.service.impl.SprintMapper">

    <!-- 스프린트 한 건 (sp_sprint) -->
    <select id="selectSprintById" statementType="CALLABLE" resultType="com.flowspace.sprint.service.SprintVO">
        {call sp_sprint(#{sprintId})}
    </select>

    <!-- 스프린트 목록 + 진행 상황 (sp_sprint_progress_list) -->
    <select id="selectSprintProgressList" statementType="CALLABLE"
            resultType="com.flowspace.sprint.service.SprintProgressVO">
        {call sp_sprint_progress_list(#{workspaceId})}
    </select>

    <!-- 스프린트 한 건과 진행 상황 -->
    <select id="selectSprintProgressById" statementType="CALLABLE"
            resultType="com.flowspace.sprint.service.SprintProgressVO">
        {call sp_sprint_progress(#{sprintId})}
    </select>

    <!-- 워크스페이스에서 해당 상태인 스프린트 수 (sp_sprint_count_by_status) -->
    <select id="selectSprintCountByStatus" statementType="CALLABLE" resultType="int">
        {call sp_sprint_count_by_status(#{workspaceId}, #{status})}
    </select>

    <!-- 스프린트 등록 (sp_sprint_insert, 생성 시각은 DB 기본값) -->
    <insert id="insertSprint" statementType="CALLABLE" parameterType="com.flowspace.sprint.service.SprintVO">
        {call sp_sprint_insert(#{workspaceId}, #{createdBy}, #{name}, #{goal}, #{description}, #{color},
                               #{startDate}, #{endDate}, #{status}, #{sprintId, mode=OUT, jdbcType=BIGINT})}
    </insert>

    <!-- 스프린트 수정 (sp_sprint_update, 상태 제외) -->
    <update id="updateSprint" statementType="CALLABLE" parameterType="com.flowspace.sprint.service.SprintVO">
        {call sp_sprint_update(#{name}, #{goal}, #{description}, #{color}, #{startDate}, #{endDate}, #{sprintId})}
    </update>

    <!-- 스프린트 시작 (sp_start_sprint) -->
    <update id="updateSprintStart" statementType="CALLABLE">
        {call sp_start_sprint(#{sprintId})}
    </update>

    <!-- 스프린트 완료 (sp_complete_sprint) -->
    <update id="updateSprintComplete" statementType="CALLABLE">
        {call sp_complete_sprint(#{sprintId})}
    </update>

    <!-- 스프린트 삭제 (sp_delete_sprint) -->
    <delete id="deleteSprint" statementType="CALLABLE">
        {call sp_delete_sprint(#{sprintId})}
    </delete>

</mapper>
