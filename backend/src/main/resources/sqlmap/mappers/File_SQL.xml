<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flowspace.file.service.impl.FileMapper">

    <!-- 이메일로 사용자 번호 (sp_user_id_by_email) -->
    <select id="selectUserIdByEmail" statementType="CALLABLE" resultType="long">
        {call sp_user_id_by_email(#{email})}
    </select>

    <!-- 파일 한 건 (sp_file) -->
    <select id="selectFileById" statementType="CALLABLE" resultType="com.flowspace.file.service.FileVO">
        {call sp_file(#{fileId})}
    </select>

    <!-- 파일 등록 (sp_file_insert, 새 번호는 OUT으로 fileId에) -->
    <insert id="insertFile" statementType="CALLABLE" parameterType="com.flowspace.file.service.FileVO">
        {call sp_file_insert(#{workspaceId}, #{uploadedBy}, #{originalName}, #{storedName}, #{mimeType}, #{size},
                             #{width}, #{height}, #{fileUrl}, #{fileId, mode=OUT, jdbcType=BIGINT})}
    </insert>

    <!-- 파일 삭제 (sp_file_delete) -->
    <delete id="deleteFile" statementType="CALLABLE">
        {call sp_file_delete(#{fileId})}
    </delete>

</mapper>
