<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flowspace.search.service.impl.SearchMapper">

    <!-- 제목이 맞는 페이지 -->
    <select id="selectPageListByTitle" resultType="com.flowspace.search.service.SearchResultVO">
        SELECT page_id AS id,
               title,
               icon
        FROM pages
        WHERE workspace_id = #{workspaceId}
          AND is_deleted = FALSE
          AND LOWER(title) LIKE #{like} ESCAPE '!'
        ORDER BY page_id DESC
        LIMIT #{limit}
    </select>

    <!-- 본문 검색 후보 블록 (sp_search_block_list) -->
    <select id="selectBlockList" statementType="CALLABLE" resultType="com.flowspace.search.service.SearchResultVO">
        {call sp_search_block_list(#{workspaceId}, #{like})}
    </select>

    <!-- 작업 (sp_search_task_list) -->
    <select id="selectTaskList" statementType="CALLABLE" resultType="com.flowspace.search.service.SearchResultVO">
        {call sp_search_task_list(#{workspaceId}, #{like}, #{limit})}
    </select>

    <!-- 스프린트 -->
    <select id="selectSprintList" resultType="com.flowspace.search.service.SearchResultVO">
        SELECT sprint_id AS id,
               name      AS title,
               goal      AS body
        FROM sprints
        WHERE workspace_id = #{workspaceId}
          AND (LOWER(name) LIKE #{like} ESCAPE '!'
               OR LOWER(COALESCE(goal, '')) LIKE #{like} ESCAPE '!')
        ORDER BY sprint_id DESC
        LIMIT #{limit}
    </select>

    <!-- 댓글 (sp_search_comment_list) -->
    <select id="selectCommentList" statementType="CALLABLE" resultType="com.flowspace.search.service.SearchResultVO">
        {call sp_search_comment_list(#{workspaceId}, #{like}, #{limit})}
    </select>

    <!-- 일정 -->
    <select id="selectEventList" resultType="com.flowspace.search.service.SearchResultVO">
        SELECT event_id    AS id,
               title,
               description AS body,
               start_datetime
        FROM events
        WHERE workspace_id = #{workspaceId}
          AND (LOWER(title) LIKE #{like} ESCAPE '!'
               OR LOWER(COALESCE(description, '')) LIKE #{like} ESCAPE '!')
        ORDER BY start_datetime DESC
        LIMIT #{limit}
    </select>

</mapper>
