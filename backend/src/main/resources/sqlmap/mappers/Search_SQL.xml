<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flowspace.search.service.impl.SearchMapper">

    <!-- 제목이 맞는 페이지 (sp_search_page_list) -->
    <select id="selectPageListByTitle" statementType="CALLABLE" resultType="com.flowspace.search.service.SearchResultVO">
        {call sp_search_page_list(#{workspaceId}, #{like}, #{limit})}
    </select>

    <!-- 본문 검색 후보 블록 (sp_search_block_list) -->
    <select id="selectBlockList" statementType="CALLABLE" resultType="com.flowspace.search.service.SearchResultVO">
        {call sp_search_block_list(#{workspaceId}, #{like})}
    </select>

    <!-- 작업 (sp_search_task_list) -->
    <select id="selectTaskList" statementType="CALLABLE" resultType="com.flowspace.search.service.SearchResultVO">
        {call sp_search_task_list(#{workspaceId}, #{like}, #{limit})}
    </select>

    <!-- 스프린트 (sp_search_sprint_list) -->
    <select id="selectSprintList" statementType="CALLABLE" resultType="com.flowspace.search.service.SearchResultVO">
        {call sp_search_sprint_list(#{workspaceId}, #{like}, #{limit})}
    </select>

    <!-- 댓글 (sp_search_comment_list) -->
    <select id="selectCommentList" statementType="CALLABLE" resultType="com.flowspace.search.service.SearchResultVO">
        {call sp_search_comment_list(#{workspaceId}, #{like}, #{limit})}
    </select>

    <!-- 일정 (sp_search_event_list) -->
    <select id="selectEventList" statementType="CALLABLE" resultType="com.flowspace.search.service.SearchResultVO">
        {call sp_search_event_list(#{workspaceId}, #{like}, #{limit})}
    </select>

</mapper>
