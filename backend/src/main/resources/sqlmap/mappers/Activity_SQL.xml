<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flowspace.activity.service.impl.ActivityMapper">

    <!-- 활동 기록 등록 (sp_activity_insert) -->
    <insert id="insertActivity" statementType="CALLABLE" parameterType="com.flowspace.activity.service.ActivityVO">
        {call sp_activity_insert(#{workspaceId}, #{userId}, #{type}, #{targetType}, #{targetId})}
    </insert>

    <!-- 활동 기록 목록 (sp_activity_list, null 가능 인자는 jdbcType 지정) -->
    <select id="selectActivityList" statementType="CALLABLE" resultType="com.flowspace.activity.service.ActivityVO">
        {call sp_activity_list(#{workspaceId}, #{userId, jdbcType=BIGINT}, #{types, jdbcType=VARCHAR},
                               #{offset}, #{limit})}
    </select>

    <!-- 같은 조건의 활동 기록 수 (sp_activity_count) -->
    <select id="selectActivityCount" statementType="CALLABLE" resultType="long">
        {call sp_activity_count(#{workspaceId}, #{userId}, #{types})}
    </select>

    <!-- 사용자 존재 여부 (sp_user_count) -->
    <select id="selectUserCount" statementType="CALLABLE" resultType="int">
        {call sp_user_count(#{userId})}
    </select>

</mapper>
