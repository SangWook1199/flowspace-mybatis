<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flowspace.activity.service.impl.ActivityMapper">

    <!-- 활동 기록 등록. 만든 시각은 DB 기본값을 써요. -->
    <insert id="insertActivity" parameterType="com.flowspace.activity.service.ActivityVO">
        INSERT INTO activities (workspace_id, user_id, type, target_type, target_id)
        VALUES (#{workspaceId}, #{userId}, #{type}, #{targetType}, #{targetId})
    </insert>

    <!-- 활동 기록 목록. 대상 이름 조인은 프로시저 안에서 해요(backend/database/procedures/activity).
         userId, types가 null일 수 있어서 jdbcType을 적어요. -->
    <select id="selectActivityList" statementType="CALLABLE" resultType="com.flowspace.activity.service.ActivityVO">
        {call sp_activity_list(#{workspaceId}, #{userId, jdbcType=BIGINT}, #{types, jdbcType=VARCHAR},
                               #{offset}, #{limit})}
    </select>

    <!-- 같은 조건의 활동 기록 수. 테이블 하나라서 XML의 동적 SQL로 조건을 붙여요.
         (프로시저는 FIND_IN_SET, XML은 foreach — 목록 조건을 넘기는 두 가지 방법이에요) -->
    <select id="selectActivityCount" resultType="long">
        SELECT COUNT(*)
        FROM activities
        WHERE workspace_id = #{workspaceId}
        <if test="userId != null">
          AND user_id = #{userId}
        </if>
        <if test="types != null">
          AND type IN
          <foreach collection="types" item="type" open="(" separator="," close=")">
              #{type}
          </foreach>
        </if>
    </select>

    <!-- 사용자가 있는지 -->
    <select id="selectUserCount" resultType="int">
        SELECT COUNT(*)
        FROM users
        WHERE user_id = #{userId}
    </select>

</mapper>
