<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flowspace.task.service.impl.TaskMapper">

    <!-- 칸반 작업 목록 (sp_task_list, sprintId null이면 백로그) -->
    <select id="selectTaskList" statementType="CALLABLE" resultType="com.flowspace.task.service.TaskVO">
        {call sp_task_list(#{workspaceId}, #{sprintId, jdbcType=BIGINT})}
    </select>

    <!-- 칸반 작업들의 담당자 -->
    <select id="selectTaskAssigneeList" statementType="CALLABLE"
            resultType="com.flowspace.task.service.TaskAssigneeVO">
        {call sp_task_assignee_list(#{workspaceId}, #{sprintId, jdbcType=BIGINT})}
    </select>

    <!-- 여러 작업의 하위 작업 (sp_subtask_list) -->
    <select id="selectSubTaskList" statementType="CALLABLE" resultType="com.flowspace.task.service.SubTaskVO">
        {call sp_subtask_list(#{taskIds, typeHandler=com.flowspace.common.mybatis.IdListTypeHandler})}
    </select>

    <!-- 작업 한 건과 상태 이름 -->
    <select id="selectTaskById" statementType="CALLABLE" resultType="com.flowspace.task.service.TaskVO">
        {call sp_task(#{taskId})}
    </select>

    <!-- 작업 한 건의 담당자 -->
    <select id="selectTaskAssigneeListByTaskId" statementType="CALLABLE"
            resultType="com.flowspace.task.service.TaskAssigneeVO">
        {call sp_task_assignee(#{taskId})}
    </select>

    <!-- 워크스페이스에서 해당 상태인 작업 수 (sp_task_count_by_status) -->
    <select id="selectTaskCountByStatus" statementType="CALLABLE" resultType="int">
        {call sp_task_count_by_status(#{workspaceId}, #{statusId})}
    </select>

    <!-- 워크스페이스의 최대 작업 번호 (sp_task_max_number, 없으면 0) -->
    <select id="selectMaxTaskNumber" statementType="CALLABLE" resultType="int">
        {call sp_task_max_number(#{workspaceId})}
    </select>

    <!-- 작업 등록 (sp_task_insert, 생성 시각은 DB 기본값) -->
    <insert id="insertTask" statementType="CALLABLE" parameterType="com.flowspace.task.service.TaskVO">
        {call sp_task_insert(#{workspaceId}, #{sprintId}, #{statusId}, #{taskNumber}, #{position}, #{createdBy},
                             #{title}, #{description}, #{startDate}, #{endDate}, #{priority},
                             #{taskId, mode=OUT, jdbcType=BIGINT})}
    </insert>

    <!-- 작업 담당자 등록 (sp_task_assignee_insert) -->
    <insert id="insertTaskAssignee" statementType="CALLABLE">
        {call sp_task_assignee_insert(#{taskId}, #{userId})}
    </insert>

    <!-- 작업 수정 (sp_task_update) -->
    <update id="updateTask" statementType="CALLABLE" parameterType="com.flowspace.task.service.TaskVO">
        {call sp_task_update(#{sprintId}, #{statusId}, #{position}, #{title}, #{description}, #{startDate},
                             #{endDate}, #{priority}, #{completedAt}, #{taskId})}
    </update>

    <!-- 작업 담당자의 사용자 번호 목록 (sp_task_assignee_user_id_list) -->
    <select id="selectTaskAssigneeUserIds" statementType="CALLABLE" resultType="long">
        {call sp_task_assignee_user_id_list(#{taskId})}
    </select>

    <!-- 작업 담당자 모두 삭제 (sp_task_assignee_delete) -->
    <delete id="deleteTaskAssignees" statementType="CALLABLE">
        {call sp_task_assignee_delete(#{taskId})}
    </delete>

    <!-- 작업 담당자가 아닌 하위 작업 담당자 해제 (sp_subtask_assignee_clear, 남은 담당자가 없으면 전체 해제) -->
    <update id="updateSubTaskAssigneeClear" statementType="CALLABLE">
        {call sp_subtask_assignee_clear(#{taskId},
                                        #{assigneeIds, typeHandler=com.flowspace.common.mybatis.IdListTypeHandler})}
    </update>

    <!-- 작업 삭제 (sp_delete_task) -->
    <delete id="deleteTask" statementType="CALLABLE">
        {call sp_delete_task(#{taskId})}
    </delete>

    <!-- 작업 담당자 여부 (sp_task_assignee_count) -->
    <select id="selectTaskAssigneeCount" statementType="CALLABLE" resultType="int">
        {call sp_task_assignee_count(#{taskId}, #{userId})}
    </select>

    <!-- 하위 작업 한 건 (sp_subtask) -->
    <select id="selectSubTaskById" statementType="CALLABLE" resultType="com.flowspace.task.service.SubTaskVO">
        {call sp_subtask(#{subtaskId})}
    </select>

    <!-- 작업의 하위 작업 수 (sp_subtask_count) -->
    <select id="selectSubTaskCount" statementType="CALLABLE" resultType="int">
        {call sp_subtask_count(#{taskId})}
    </select>

    <!-- 하위 작업 등록 (sp_subtask_insert, is_completed는 DB 기본값) -->
    <insert id="insertSubTask" statementType="CALLABLE" parameterType="com.flowspace.task.service.SubTaskVO">
        {call sp_subtask_insert(#{taskId}, #{assigneeId}, #{content}, #{position},
                                #{subtaskId, mode=OUT, jdbcType=BIGINT})}
    </insert>

    <!-- 하위 작업 수정 (sp_subtask_update) -->
    <update id="updateSubTask" statementType="CALLABLE" parameterType="com.flowspace.task.service.SubTaskVO">
        {call sp_subtask_update(#{content}, #{assigneeId}, #{isCompleted}, #{subtaskId})}
    </update>

    <!-- 하위 작업 순서 변경 (sp_subtask_position_update) -->
    <update id="updateSubTaskPosition" statementType="CALLABLE">
        {call sp_subtask_position_update(#{position}, #{subtaskId})}
    </update>

    <!-- 하위 작업 삭제 (sp_subtask_delete) -->
    <delete id="deleteSubTask" statementType="CALLABLE">
        {call sp_subtask_delete(#{subtaskId})}
    </delete>

    <!-- 워크스페이스 작업 상태 목록 (sp_task_status_list) -->
    <select id="selectTaskStatusList" statementType="CALLABLE"
            resultType="com.flowspace.task.service.TaskStatusVO">
        {call sp_task_status_list(#{workspaceId})}
    </select>

    <!-- 워크스페이스의 작업 상태 한 개 -->
    <select id="selectTaskStatusById" statementType="CALLABLE"
            resultType="com.flowspace.task.service.TaskStatusVO">
        {call sp_task_status(#{workspaceId}, #{statusId})}
    </select>

    <!-- 워크스페이스의 작업 상태 수 (sp_task_status_count) -->
    <select id="selectTaskStatusCount" statementType="CALLABLE" resultType="int">
        {call sp_task_status_count(#{workspaceId})}
    </select>

    <!-- 상태 등록 (sp_task_status_insert) -->
    <insert id="insertTaskStatus" statementType="CALLABLE" parameterType="com.flowspace.task.service.TaskStatusVO">
        {call sp_task_status_insert(#{name}, #{category}, #{color}, #{statusId, mode=OUT, jdbcType=BIGINT})}
    </insert>

    <!-- 워크스페이스에 상태 연결 (sp_workspace_task_status_insert, is_default는 DB 기본값) -->
    <insert id="insertWorkspaceTaskStatus" statementType="CALLABLE" parameterType="com.flowspace.task.service.TaskStatusVO">
        {call sp_workspace_task_status_insert(#{workspaceId}, #{statusId}, #{position}, #{wipLimit})}
    </insert>

    <!-- 상태 정보 수정 (sp_task_status_update) -->
    <update id="updateTaskStatusInfo" statementType="CALLABLE" parameterType="com.flowspace.task.service.TaskStatusVO">
        {call sp_task_status_update(#{name}, #{category}, #{color}, #{statusId})}
    </update>

    <!-- 워크스페이스별 WIP 제한 수정 (sp_workspace_task_status_wip_limit_update) -->
    <update id="updateWorkspaceTaskStatusWipLimit" statementType="CALLABLE" parameterType="com.flowspace.task.service.TaskStatusVO">
        {call sp_workspace_task_status_wip_limit_update(#{wipLimit}, #{workspaceId}, #{statusId})}
    </update>

    <!-- 칸반 열 순서 변경 (sp_workspace_task_status_position_update) -->
    <update id="updateTaskStatusPosition" statementType="CALLABLE">
        {call sp_workspace_task_status_position_update(#{position}, #{workspaceId}, #{statusId})}
    </update>

    <!-- 기본 상태를 새 상태로 교체 (sp_replace_default_task_status) -->
    <update id="updateDefaultTaskStatus" statementType="CALLABLE">
        {call sp_replace_default_task_status(#{workspaceId}, #{oldStatusId}, #{newStatusId},
                                             #{wipLimit, jdbcType=INTEGER})}
    </update>

    <!-- 상태 삭제 + 작업 이동 (sp_delete_task_status) -->
    <delete id="deleteTaskStatus" statementType="CALLABLE">
        {call sp_delete_task_status(#{workspaceId}, #{statusId}, #{targetStatusId})}
    </delete>

    <!-- 제목으로 작업 검색 (sp_task_search) -->
    <select id="selectTaskSearchList" statementType="CALLABLE" resultType="com.flowspace.task.service.TaskVO">
        {call sp_task_search(#{workspaceId}, #{keyword})}
    </select>

    <!-- 여러 작업의 담당자 (sp_task_assignee_list_by_tasks, sp_task_assignee_list와 같은 컬럼) -->
    <select id="selectTaskAssigneeListByTaskIds" statementType="CALLABLE"
            resultType="com.flowspace.task.service.TaskAssigneeVO">
        {call sp_task_assignee_list_by_tasks(#{taskIds, typeHandler=com.flowspace.common.mybatis.IdListTypeHandler})}
    </select>

    <!-- 이메일로 사용자 (sp_user_by_email) -->
    <select id="selectUserByEmail" statementType="CALLABLE" resultType="com.flowspace.user.service.UserVO">
        {call sp_user_by_email(#{email})}
    </select>

    <!-- 번호로 사용자 (sp_user) -->
    <select id="selectUserById" statementType="CALLABLE" resultType="com.flowspace.user.service.UserVO">
        {call sp_user(#{userId})}
    </select>

    <!-- 스프린트가 속한 워크스페이스 번호 (sp_sprint_workspace_id) -->
    <select id="selectSprintWorkspaceId" statementType="CALLABLE" resultType="long">
        {call sp_sprint_workspace_id(#{sprintId})}
    </select>

    <!-- 워크스페이스 멤버 수 (sp_workspace_member_count) -->
    <select id="selectWorkspaceMemberCount" statementType="CALLABLE" resultType="int">
        {call sp_workspace_member_count(#{workspaceId}, #{userId})}
    </select>

</mapper>
