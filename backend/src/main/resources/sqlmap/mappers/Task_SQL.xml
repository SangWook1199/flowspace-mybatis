<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flowspace.task.service.impl.TaskMapper">

    <!-- 칸반 작업 목록과 상태 이름. 조인은 프로시저 안에서 해요(backend/database/procedures/task).
         sprintId가 null일 수 있어서 jdbcType을 적어 줘요(값이 없으면 어떤 타입의 NULL인지 알려 줘야 해요). -->
    <select id="selectTaskList" statementType="CALLABLE" resultType="com.flowspace.task.service.TaskVO">
        {call sp_task_list(#{workspaceId}, #{sprintId, jdbcType=BIGINT})}
    </select>

    <!-- 칸반 작업들의 담당자 -->
    <select id="selectTaskAssigneeList" statementType="CALLABLE"
            resultType="com.flowspace.task.service.TaskAssigneeVO">
        {call sp_task_assignee_list(#{workspaceId}, #{sprintId, jdbcType=BIGINT})}
    </select>

    <!-- 여러 작업의 하위 작업. foreach가 taskIds를 (1, 2, 3) 모양으로 펼쳐 줘요. -->
    <select id="selectSubTaskList" resultType="com.flowspace.task.service.SubTaskVO">
        SELECT subtask_id, task_id, assignee_id, content, is_completed, position
        FROM subtasks
        WHERE task_id IN
        <foreach collection="taskIds" item="taskId" open="(" separator="," close=")">
            #{taskId}
        </foreach>
        ORDER BY position
    </select>

    <!-- 작업 한 건과 상태 이름 -->
    <select id="selectTaskById" statementType="CALLABLE" resultType="com.flowspace.task.service.TaskVO">
        {call sp_task(#{taskId})}
    </select>

    <!-- 작업 한 건의 담당자 -->
    <select id="selectTaskAssigneeListByTaskId" statementType="CALLABLE"
            resultType="com.flowspace.task.service.TaskAssigneeVO">
        {call sp_task_assignee(#{taskId})}
    </select>

    <!-- 워크스페이스에서 해당 상태인 작업 수 -->
    <select id="selectTaskCountByStatus" resultType="int">
        SELECT COUNT(*)
        FROM tasks
        WHERE workspace_id = #{workspaceId}
          AND status_id = #{statusId}
    </select>

    <!-- 워크스페이스에서 지금까지 쓴 가장 큰 작업 번호 (작업이 없으면 0) -->
    <select id="selectMaxTaskNumber" resultType="int">
        SELECT COALESCE(MAX(task_number), 0)
        FROM tasks
        WHERE workspace_id = #{workspaceId}
    </select>

    <!-- 작업 등록. DB가 만든 task_id를 VO의 taskId에 넣어 줘요.
         완료 시각은 비워 두고, 만든 시각은 DB 기본값을 써요. -->
    <insert id="insertTask" parameterType="com.flowspace.task.service.TaskVO"
            useGeneratedKeys="true" keyProperty="taskId">
        INSERT INTO tasks (workspace_id, sprint_id, status_id, task_number, position, created_by,
                           title, description, start_date, end_date, priority)
        VALUES (#{workspaceId}, #{sprintId}, #{statusId}, #{taskNumber}, #{position}, #{createdBy},
                #{title}, #{description}, #{startDate}, #{endDate}, #{priority})
    </insert>

    <!-- 작업 담당자 등록 -->
    <insert id="insertTaskAssignee">
        INSERT INTO task_assignees (task_id, user_id)
        VALUES (#{taskId}, #{userId})
    </insert>

    <!-- 작업 수정 -->
    <update id="updateTask" parameterType="com.flowspace.task.service.TaskVO">
        UPDATE tasks
           SET sprint_id    = #{sprintId},
               status_id    = #{statusId},
               position     = #{position},
               title        = #{title},
               description  = #{description},
               start_date   = #{startDate},
               end_date     = #{endDate},
               priority     = #{priority},
               completed_at = #{completedAt}
         WHERE task_id = #{taskId}
    </update>

    <!-- 작업 담당자의 사용자 번호 목록 -->
    <select id="selectTaskAssigneeUserIds" resultType="long">
        SELECT user_id
        FROM task_assignees
        WHERE task_id = #{taskId}
    </select>

    <!-- 작업 담당자 모두 삭제 -->
    <delete id="deleteTaskAssignees">
        DELETE FROM task_assignees
        WHERE task_id = #{taskId}
    </delete>

    <!-- 작업 담당자에서 빠진 사람이 맡은 하위 작업의 담당자를 비워요.
         if: 남은 담당자가 있을 때만 NOT IN 조건을 붙여요(없으면 하위 작업 담당자를 모두 비워요). -->
    <update id="updateSubTaskAssigneeClear">
        UPDATE subtasks
           SET assignee_id = NULL
         WHERE task_id = #{taskId}
           AND assignee_id IS NOT NULL
        <if test="assigneeIds != null and assigneeIds.size() > 0">
           AND assignee_id NOT IN
           <foreach collection="assigneeIds" item="userId" open="(" separator="," close=")">
               #{userId}
           </foreach>
        </if>
    </update>

    <!-- 작업 삭제. 남은 작업의 순서를 다시 매기는 것까지 프로시저 안에서 해요. -->
    <delete id="deleteTask" statementType="CALLABLE">
        {call sp_delete_task(#{taskId})}
    </delete>

    <!-- 작업 담당자인지 확인 -->
    <select id="selectTaskAssigneeCount" resultType="int">
        SELECT COUNT(*)
        FROM task_assignees
        WHERE task_id = #{taskId}
          AND user_id = #{userId}
    </select>

    <!-- 하위 작업 한 건 -->
    <select id="selectSubTaskById" resultType="com.flowspace.task.service.SubTaskVO">
        SELECT subtask_id, task_id, assignee_id, content, is_completed, position
        FROM subtasks
        WHERE subtask_id = #{subtaskId}
    </select>

    <!-- 작업의 하위 작업 수 -->
    <select id="selectSubTaskCount" resultType="int">
        SELECT COUNT(*)
        FROM subtasks
        WHERE task_id = #{taskId}
    </select>

    <!-- 하위 작업 등록. 완료 여부는 넣지 않아서 DB 기본값(FALSE)이 들어가요. -->
    <insert id="insertSubTask" parameterType="com.flowspace.task.service.SubTaskVO"
            useGeneratedKeys="true" keyProperty="subtaskId">
        INSERT INTO subtasks (task_id, assignee_id, content, position)
        VALUES (#{taskId}, #{assigneeId}, #{content}, #{position})
    </insert>

    <!-- 하위 작업 수정 -->
    <update id="updateSubTask" parameterType="com.flowspace.task.service.SubTaskVO">
        UPDATE subtasks
           SET content      = #{content},
               assignee_id  = #{assigneeId},
               is_completed = #{isCompleted}
         WHERE subtask_id = #{subtaskId}
    </update>

    <!-- 하위 작업 순서 변경 -->
    <update id="updateSubTaskPosition">
        UPDATE subtasks
           SET position = #{position}
         WHERE subtask_id = #{subtaskId}
    </update>

    <!-- 하위 작업 삭제 -->
    <delete id="deleteSubTask">
        DELETE FROM subtasks
        WHERE subtask_id = #{subtaskId}
    </delete>

</mapper>
