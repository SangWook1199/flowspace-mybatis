<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flowspace.workspace.service.impl.WorkspaceMapper">

    <!-- 워크스페이스 한 건 (sp_workspace) -->
    <select id="selectWorkspaceById" statementType="CALLABLE" resultType="com.flowspace.workspace.service.WorkspaceVO">
        {call sp_workspace(#{workspaceId})}
    </select>

    <!-- 워크스페이스에서 사용자의 역할 (sp_workspace_member_role, enum으로 매핑, 없으면 null) -->
    <select id="selectMemberRole" statementType="CALLABLE" resultType="com.flowspace.entity.enums.WorkspaceRole">
        {call sp_workspace_member_role(#{workspaceId}, #{userId})}
    </select>

    <!-- 내 워크스페이스 목록 + 역할 (sp_my_workspace_list) -->
    <select id="selectMyWorkspaceList" statementType="CALLABLE"
            resultType="com.flowspace.workspace.service.WorkspaceVO">
        {call sp_my_workspace_list(#{userId})}
    </select>

    <!-- 멤버 목록 -->
    <select id="selectWorkspaceMemberList" statementType="CALLABLE"
            resultType="com.flowspace.workspace.service.WorkspaceMemberVO">
        {call sp_workspace_member_list(#{workspaceId})}
    </select>

    <!-- 멤버 한 명 -->
    <select id="selectWorkspaceMember" statementType="CALLABLE"
            resultType="com.flowspace.workspace.service.WorkspaceMemberVO">
        {call sp_workspace_member(#{workspaceId}, #{userId})}
    </select>

    <!-- 멤버의 미완료 담당 작업 -->
    <select id="selectMemberOpenTaskList" statementType="CALLABLE"
            resultType="com.flowspace.workspace.service.MemberTaskVO">
        {call sp_member_open_task_list(#{workspaceId}, #{userId}, #{limit})}
    </select>

    <!-- 멤버가 맡은 작업의 진행 중·완료 수 -->
    <select id="selectMemberTaskCount" statementType="CALLABLE"
            resultType="com.flowspace.workspace.service.MemberTaskCountVO">
        {call sp_member_task_count(#{workspaceId}, #{userId})}
    </select>

    <!-- 내가 속한 워크스페이스 수 (sp_my_workspace_count) -->
    <select id="selectMyWorkspaceCount" statementType="CALLABLE" resultType="int">
        {call sp_my_workspace_count(#{userId})}
    </select>

    <!-- 워크스페이스 등록 (sp_workspace_insert, 생성 시각은 DB 기본값) -->
    <insert id="insertWorkspace" statementType="CALLABLE" parameterType="com.flowspace.workspace.service.WorkspaceVO">
        {call sp_workspace_insert(#{ownerId}, #{name}, #{initials}, #{color}, #{icon},
                                  #{workspaceId, mode=OUT, jdbcType=BIGINT})}
    </insert>

    <!-- 소유자와 기본 상태 연결 -->
    <insert id="insertWorkspaceInit" statementType="CALLABLE">
        {call sp_init_workspace(#{workspaceId}, #{ownerId})}
    </insert>

    <!-- 워크스페이스 수정 (sp_workspace_update) -->
    <update id="updateWorkspace" statementType="CALLABLE" parameterType="com.flowspace.workspace.service.WorkspaceVO">
        {call sp_workspace_update(#{name}, #{initials}, #{color}, #{icon}, #{workspaceId})}
    </update>

    <!-- 워크스페이스 삭제 -->
    <delete id="deleteWorkspace" statementType="CALLABLE">
        {call sp_delete_workspace(#{workspaceId})}
    </delete>

    <!-- 대기 중인 초대 수 (sp_pending_invite_count) -->
    <select id="selectPendingInviteCount" statementType="CALLABLE" resultType="int">
        {call sp_pending_invite_count(#{workspaceId}, #{email})}
    </select>

    <!-- 초대 등록 (sp_invite_insert, 생성 시각은 DB 기본값) -->
    <insert id="insertInvite" statementType="CALLABLE" parameterType="com.flowspace.workspace.service.InviteVO">
        {call sp_invite_insert(#{workspaceId}, #{inviterId}, #{email}, #{status},
                               #{inviteId, mode=OUT, jdbcType=BIGINT})}
    </insert>

    <!-- 받은 초대 목록 (sp_my_invite_list) -->
    <select id="selectMyInviteList" statementType="CALLABLE" resultType="com.flowspace.workspace.service.InviteVO">
        {call sp_my_invite_list(#{email})}
    </select>

    <!-- 초대 한 건 (sp_invite) -->
    <select id="selectInviteById" statementType="CALLABLE" resultType="com.flowspace.workspace.service.InviteVO">
        {call sp_invite(#{inviteId})}
    </select>

    <!-- 초대 응답 처리 (sp_invite_status_update) -->
    <update id="updateInviteStatus" statementType="CALLABLE">
        {call sp_invite_status_update(#{status}, #{inviteId})}
    </update>

    <!-- 멤버 추가 (sp_workspace_member_insert, 참여 시각은 DB 기본값) -->
    <insert id="insertWorkspaceMember" statementType="CALLABLE">
        {call sp_workspace_member_insert(#{workspaceId}, #{userId}, #{role})}
    </insert>

    <!-- 멤버 역할 변경 (sp_workspace_member_role_update) -->
    <update id="updateMemberRole" statementType="CALLABLE">
        {call sp_workspace_member_role_update(#{role}, #{workspaceId}, #{userId})}
    </update>

    <!-- 워크스페이스 소유자 변경 (sp_workspace_owner_update) -->
    <update id="updateWorkspaceOwner" statementType="CALLABLE">
        {call sp_workspace_owner_update(#{ownerId}, #{workspaceId})}
    </update>

    <!-- 멤버 삭제 (sp_workspace_member_delete) -->
    <delete id="deleteWorkspaceMember" statementType="CALLABLE">
        {call sp_workspace_member_delete(#{workspaceId}, #{userId})}
    </delete>

    <!-- 사용자의 마지막 워크스페이스 지정 (sp_user_last_workspace_update, 워크스페이스 생성 시 함께 변경) -->
    <update id="updateUserLastWorkspace" statementType="CALLABLE">
        {call sp_user_last_workspace_update(#{workspaceId}, #{userId})}
    </update>

    <!-- 마지막 워크스페이스가 이곳이면 해제 (sp_user_last_workspace_clear) -->
    <update id="clearUserLastWorkspace" statementType="CALLABLE">
        {call sp_user_last_workspace_clear(#{userId}, #{workspaceId})}
    </update>

    <!-- 이메일로 사용자 (sp_user_by_email) -->
    <select id="selectUserByEmail" statementType="CALLABLE" resultType="com.flowspace.user.service.UserVO">
        {call sp_user_by_email(#{email})}
    </select>

    <!-- 번호로 사용자 (sp_user) -->
    <select id="selectUserById" statementType="CALLABLE" resultType="com.flowspace.user.service.UserVO">
        {call sp_user(#{userId})}
    </select>

</mapper>
