<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flowspace.comment.service.impl.CommentMapper">

    <!-- 이메일로 사용자 번호와 닉네임 (sp_user_name_by_email) -->
    <select id="selectUserByEmail" statementType="CALLABLE" resultType="com.flowspace.user.service.UserVO">
        {call sp_user_name_by_email(#{email})}
    </select>

    <!-- ==================== 댓글 ==================== -->

    <!-- 댓글 한 건 (sp_comment) -->
    <select id="selectCommentById" statementType="CALLABLE" resultType="com.flowspace.comment.service.CommentVO">
        {call sp_comment(#{commentId})}
    </select>

    <!-- 여러 작업의 댓글 (sp_comment_list_by_tasks, 원 댓글·답글 함께 조회) -->
    <select id="selectCommentListByTaskIds" statementType="CALLABLE"
            resultType="com.flowspace.comment.service.CommentVO">
        {call sp_comment_list_by_tasks(#{taskIds, typeHandler=com.flowspace.common.mybatis.IdListTypeHandler})}
    </select>

    <!-- 여러 블록의 댓글 (sp_comment_list_by_blocks) -->
    <select id="selectCommentListByBlockIds" statementType="CALLABLE"
            resultType="com.flowspace.comment.service.CommentVO">
        {call sp_comment_list_by_blocks(#{blockIds, typeHandler=com.flowspace.common.mybatis.IdListTypeHandler})}
    </select>

    <!-- 댓글 등록 (sp_comment_insert, taskId, blockId 중 하나) -->
    <insert id="insertComment" statementType="CALLABLE" parameterType="com.flowspace.comment.service.CommentVO">
        {call sp_comment_insert(#{taskId}, #{blockId}, #{userId}, #{parentCommentId}, #{content},
                                #{commentId, mode=OUT, jdbcType=BIGINT})}
    </insert>

    <!-- 댓글 내용 수정 (sp_comment_content_update) -->
    <update id="updateCommentContent" statementType="CALLABLE">
        {call sp_comment_content_update(#{content}, #{commentId})}
    </update>

    <!-- 댓글 삭제 (sp_comment_delete, 답글은 ON DELETE CASCADE) -->
    <delete id="deleteComment" statementType="CALLABLE">
        {call sp_comment_delete(#{commentId})}
    </delete>

    <!-- ==================== 댓글이 달리는 곳 ==================== -->

    <!-- 작업 정보 (sp_comment_task) -->
    <select id="selectCommentTask" statementType="CALLABLE" resultType="com.flowspace.comment.service.CommentTargetVO">
        {call sp_comment_task(#{taskId})}
    </select>

    <!-- 블록이 속한 페이지 정보 (sp_comment_block) -->
    <select id="selectCommentBlock" statementType="CALLABLE" resultType="com.flowspace.comment.service.CommentTargetVO">
        {call sp_comment_block(#{blockId})}
    </select>

    <!-- 작업 담당자 번호 (sp_task_assignee_user_id_list) -->
    <select id="selectTaskAssigneeUserIds" statementType="CALLABLE" resultType="long">
        {call sp_task_assignee_user_id_list(#{taskId})}
    </select>

    <!-- 멘션된 사용자 중 워크스페이스 멤버 (sp_workspace_member_id_list) -->
    <select id="selectWorkspaceMemberIds" statementType="CALLABLE" resultType="long">
        {call sp_workspace_member_id_list(#{workspaceId},
                                          #{userIds, typeHandler=com.flowspace.common.mybatis.IdListTypeHandler})}
    </select>

</mapper>
